---
import Base from '../layouts/Base.astro';
---

<Base title="Delete Your Account — Glade & Grotto" description="How to request deletion of your Idle Grove account and data.">
  <!-- Nav -->
  <header class="w-full px-6 py-6 flex items-center justify-between max-w-5xl mx-auto">
    <a href="/" class="font-cinzel text-lg tracking-wide text-brown-dark">Glade <span class="text-terracotta">&</span> Grotto</a>
    <nav class="flex gap-6 text-sm font-inter text-brown-mid">
      <a href="/#about" class="hover:text-terracotta transition-colors">About</a>
      <a href="/#work" class="hover:text-terracotta transition-colors">Our Work</a>
      <a href="/privacy" class="hover:text-terracotta transition-colors">Privacy</a>
      <a href="/#contact" class="hover:text-terracotta transition-colors">Contact</a>
    </nav>
  </header>

  <section class="max-w-3xl mx-auto px-6 pt-8 pb-28">
    <p class="font-inter text-xs tracking-[0.2em] uppercase text-terracotta mb-4">Idle Grove</p>
    <h1 class="font-cinzel text-3xl md:text-4xl text-brown-dark leading-tight mb-3">Delete Your Account</h1>
    <p class="font-crimson text-lg text-brown-mid mb-10">
      How to request deletion of your Idle Grove account and data, published by Glade &amp; Grotto.
    </p>

    <div class="bg-surface rounded-2xl border border-border p-8 md:p-12 shadow-sm font-crimson text-brown-dark leading-relaxed space-y-8">
      <div>
        <h2 class="font-cinzel text-xl text-brown-dark mb-3">How to request deletion</h2>
        <ol class="list-decimal pl-6 space-y-2">
          <li>Email <a href="mailto:hello@gladeandgrotto.com?subject=Delete%20my%20Idle%20Grove%20account" class="text-terracotta hover:underline">hello@gladeandgrotto.com</a> from the email address associated with your account.</li>
          <li>Use the subject line <strong>"Delete my Idle Grove account"</strong> (or click the link above, which fills this in for you).</li>
          <li>We'll confirm your identity if needed, then process the deletion. You'll get a confirmation email once it's done.</li>
        </ol>
        <p class="mt-3">Requests are typically processed within a few business days.</p>
      </div>

      <div>
        <h2 class="font-cinzel text-xl text-brown-dark mb-3">What gets deleted</h2>
        <ul class="list-disc pl-6 space-y-2">
          <li>Your account and sign-in credentials</li>
          <li>Your character, inventory, and gameplay progress</li>
          <li>Any content you created in-game (grove name, chat history, trade history)</li>
        </ul>
      </div>

      <div>
        <h2 class="font-cinzel text-xl text-brown-dark mb-3">What may be retained</h2>
        <p>
          We may retain minimal records (such as a log that a deletion request was made and fulfilled) as required to
          comply with legal obligations or to prevent abuse. No gameplay data or personal profile information is kept
          beyond that.
        </p>
      </div>

      <div>
        <h2 class="font-cinzel text-xl text-brown-dark mb-3">More detail</h2>
        <p>
          See our full <a href="/privacy" class="text-terracotta hover:underline">Privacy Policy</a> for everything we
          collect and why.
        </p>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-border py-8 px-6 text-center">
    <p class="font-inter text-xs text-brown-mid">
      &copy; {new Date().getFullYear()} Glade &amp; Grotto. All rights reserved.
    </p>
  </footer>
</Base>
